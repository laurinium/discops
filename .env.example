# Copy to .env and adjust for your host.

# Container images. CI publishes these to GHCR.
IMAGE_PREFIX=ghcr.io/laurinium/discops
IMAGE_TAG=latest

# Published ports. Use 127.0.0.1:3000 / 127.0.0.1:8080 behind a reverse proxy.
FRONTEND_HTTP_BIND=3000
BACKEND_HTTP_BIND=8080

# Persistent host paths.
MUSIC_DIR=./data/music
BACKEND_DATA_DIR=./data/backend

# Ripping defaults.
OUTPUT_FORMAT=flac
AUTO_RIP=true
UDEV_MONITOR=true
POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# Optional custom abcde config mounted in compose.yaml.
# ABCDE_CONFIG=/etc/abcde.conf

# Drive 1, enabled by default.
RIPPER_SR0_ID=drive-01
RIPPER_SR0_DEVICE=/dev/sr0

# Drive 2, enable with: docker compose --profile sr1 up -d
RIPPER_SR1_ID=drive-02
RIPPER_SR1_DEVICE=/dev/sr1

# Frontend uses nginx proxy, so wildcard is safe for local default.
CORS_ORIGIN=*
