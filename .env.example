# Copy to .env and adjust for your host.

# Container images. CI publishes these to GHCR.
IMAGE_PREFIX=ghcr.io/laurinium/discops
IMAGE_TAG=latest

# Published ports. Use 127.0.0.1:3000 / 127.0.0.1:8080 behind a reverse proxy.
FRONTEND_HTTP_BIND=3000
BACKEND_HTTP_BIND=8080

# Runtime UID/GID for writable bind mounts. On the target host, use: id -u && id -g
PUID=1001
PGID=1001

# Persistent host paths.
MUSIC_DIR=./data/music
WORK_DIR=./data/work
BACKEND_DATA_DIR=./data/backend

# Ripping defaults.
OUTPUT_FORMAT=flac
AUTO_RIP=true
EJECT_ON_SUCCESS=true
EJECT_ON_FAILURE=false
UDEV_MONITOR=true
POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# Optional custom abcde config mounted in compose.yaml.
# ABCDE_CONFIG=/etc/abcde.conf

# Drive 1, enabled by default.
RIPPER_SR0_ID=drive-01
RIPPER_SR0_DEVICE=/dev/sr0
RIPPER_SR0_SG_DEVICE=/dev/sg0

# Drives to show even when their ripper container is offline/not connected.
# Format: ripperId:driveDevice:sgDevice,ripperId:driveDevice:sgDevice
EXPECTED_RIPPERS=drive-01:/dev/sr0:/dev/sg0,drive-02:/dev/sr1:/dev/sg1,drive-03:/dev/sr2:/dev/sg2,drive-04:/dev/sr3:/dev/sg4,drive-05:/dev/sr4:/dev/sg5,drive-06:/dev/sr5:/dev/sg6,drive-07:/dev/sr6:/dev/sg7,drive-08:/dev/sr7:/dev/sg8,drive-09:/dev/sr8:/dev/sg9,drive-10:/dev/sr9:/dev/sg10,drive-11:/dev/sr10:/dev/sg11

# Optional extra drives. Enable with COMPOSE_PROFILES, e.g. COMPOSE_PROFILES=sr1,sr2
# Drive 2
RIPPER_SR1_ID=drive-02
RIPPER_SR1_DEVICE=/dev/sr1
RIPPER_SR1_SG_DEVICE=/dev/sg1

# Drive 3
RIPPER_SR2_ID=drive-03
RIPPER_SR2_DEVICE=/dev/sr2
RIPPER_SR2_SG_DEVICE=/dev/sg2


# Additional optical drives
RIPPER_SR3_ID=drive-04
RIPPER_SR3_DEVICE=/dev/sr3
RIPPER_SR3_SG_DEVICE=/dev/sg4

RIPPER_SR4_ID=drive-05
RIPPER_SR4_DEVICE=/dev/sr4
RIPPER_SR4_SG_DEVICE=/dev/sg5

RIPPER_SR5_ID=drive-06
RIPPER_SR5_DEVICE=/dev/sr5
RIPPER_SR5_SG_DEVICE=/dev/sg6

RIPPER_SR6_ID=drive-07
RIPPER_SR6_DEVICE=/dev/sr6
RIPPER_SR6_SG_DEVICE=/dev/sg7

RIPPER_SR7_ID=drive-08
RIPPER_SR7_DEVICE=/dev/sr7
RIPPER_SR7_SG_DEVICE=/dev/sg8

RIPPER_SR8_ID=drive-09
RIPPER_SR8_DEVICE=/dev/sr8
RIPPER_SR8_SG_DEVICE=/dev/sg9

RIPPER_SR9_ID=drive-10
RIPPER_SR9_DEVICE=/dev/sr9
RIPPER_SR9_SG_DEVICE=/dev/sg10

RIPPER_SR10_ID=drive-11
RIPPER_SR10_DEVICE=/dev/sr10
RIPPER_SR10_SG_DEVICE=/dev/sg11

# Frontend uses nginx proxy, so wildcard is safe for local default.
CORS_ORIGIN=*
