{
  "name": "rippymcripface",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w @rippy/shared && npm run build -w @rippy/config && npm run build -w @rippy/proto && npm run build -w @rippy/backend && npm run build -w @rippy/ripper && npm run build -w @rippy/frontend",
    "dev": "npm run dev -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "proto:generate": "npm run generate -w @rippy/proto"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  }
}
